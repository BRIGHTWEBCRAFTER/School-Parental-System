        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam style strictuml\nskinparam shadowing false\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\n\ntitle Unified Sequence Diagram – School Parental System\n\nactor Parent\nactor Teacher\nactor Admin\nactor \&quot;Super Admin\&quot; as SuperAdmin\n\nparticipant \&quot;Mobile and Web\\ninterface\&quot; as UI\nparticipant \&quot;Authentication\&quot; as Auth\ndatabase \&quot;Supabase\&quot; as DB\n\nParent -&gt; UI: Enter login credentials\nactivate UI\nUI -&gt; Auth: Validate credentials\nactivate Auth\n\nalt Credentials Valid\n    Auth -&gt; DB: Query user credentials\n    activate DB\n    DB --&gt; Auth: Match found\n    deactivate DB\n    Auth --&gt; UI: Return Auth Token &amp; Session\n    UI --&gt; Parent: Grant Access to Dashboard\nelse Credentials Invalid\n    Auth -&gt; DB: Query user credentials\n    activate DB\n    DB --&gt; Auth: No match found\n    deactivate DB\n    Auth --&gt; UI: Return Error Message\n    UI --&gt; Parent: Show Login Error\nend\n\ndeactivate Auth\ndeactivate UI\n\nParent -&gt; UI: Request Child&#39;s Profile, Grades, Attendance &amp; Class Info\nactivate UI\nUI -&gt; DB: Query scoped data (RLS: Filter by Parent &amp; Child)\nactivate DB\nDB --&gt; UI: Return Student Info, Attendance, Grades, &amp; Class Data\ndeactivate DB\nUI --&gt; Parent: Display Child Academic Dashboard\ndeactivate UI\n\nParent -&gt; UI: View Announcements, Notifications &amp; Upcoming Events\nactivate UI\nUI -&gt; DB: Fetch announcements, read/unread states &amp; events (RLS: School-scoped)\nactivate DB\nDB --&gt; UI: Return Communications Data\ndeactivate DB\nUI --&gt; Parent: Display Announcements, Events, &amp; Read/Unread Status\ndeactivate UI\n\nParent -&gt; UI: Acknowledge Announcement\nactivate UI\nUI -&gt; DB: Update acknowledgement record status\nactivate DB\nDB --&gt; UI: Confirm update success\ndeactivate DB\nUI --&gt; Parent: Display updated acknowledgement status\ndeactivate UI\n\nTeacher -&gt; UI: Request Classes, Students, Records &amp; Communications\nactivate UI\nUI -&gt; DB: Query scoped data (RLS: Filter by assigned classes)\nactivate DB\nDB --&gt; UI: Return Classes, Students, Attendance, Grades &amp; Comms\ndeactivate DB\nUI --&gt; Teacher: Display Teacher Academic Dashboard\ndeactivate UI\n\nTeacher -&gt; UI: Submit / Edit Grades &amp; Attendance\nactivate UI\nUI -&gt; DB: Update academic records (RLS: Teacher permissions)\nactivate DB\nDB --&gt; UI: Confirm records updated\ndeactivate DB\nUI --&gt; Teacher: Display update success\ndeactivate UI\n\nTeacher -&gt; UI: Create Announcement &amp; Class Events\nactivate UI\nUI -&gt; DB: Insert new announcement/event (RLS: Verify permissions)\nactivate DB\nDB --&gt; UI: Confirm creation success\ndeactivate DB\nUI --&gt; Teacher: Display creation confirmation\ndeactivate UI\n\nAdmin -&gt; UI: Request School Reports, Analytics &amp; Comms Stats\nactivate UI\nUI -&gt; DB: Query scoped data (RLS: Filter by School)\nactivate DB\nDB --&gt; UI: Return Attendance, Grades &amp; Acknowledgement Stats\ndeactivate DB\nUI --&gt; Admin: Display School Admin Dashboard\ndeactivate UI\n\nAdmin -&gt; UI: Add/Edit Students, Teachers &amp; Classes\nactivate UI\nUI -&gt; DB: Execute insert/update (RLS: Admin permissions)\nactivate DB\nDB --&gt; UI: Confirm records updated\ndeactivate DB\nUI --&gt; Admin: Display update success\ndeactivate UI\n\nAdmin -&gt; UI: Create Announcements &amp; Events (incl. Acknowledgement flags)\nactivate UI\nUI -&gt; DB: Insert communication records\nactivate DB\nDB --&gt; UI: Confirm creation success\ndeactivate DB\nUI --&gt; Admin: Display creation confirmation\ndeactivate UI\n\nSuperAdmin -&gt; UI: Request Reports, Schools, Users &amp; Comms Stats\nactivate UI\nUI -&gt; DB: Query system-wide data (RLS: Super Admin access)\nactivate DB\nDB --&gt; UI: Return Global Data &amp; Specific School Details\ndeactivate DB\nUI --&gt; SuperAdmin: Display Global Dashboard\ndeactivate UI\n\nSuperAdmin -&gt; UI: Add, Edit, or Delete Schools\nactivate UI\nUI -&gt; DB: Execute database operations (RLS: Super Admin only)\nactivate DB\nDB --&gt; UI: Confirm records updated\ndeactivate DB\nUI --&gt; SuperAdmin: Display update success\ndeactivate UI\n\nSuperAdmin -&gt; UI: Create Announcements &amp; Events (Cross-School)\nactivate UI\nUI -&gt; DB: Insert communication records\nactivate DB\nDB --&gt; UI: Confirm creation success\ndeactivate DB\nUI --&gt; SuperAdmin: Display creation confirmation\ndeactivate UI\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BcHFm98C7RFCZ6zi1zxY-226">
