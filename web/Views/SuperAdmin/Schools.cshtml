@model SchoolParentalSystem.Web.ViewModels.SuperAdmin.SchoolManagementViewModel

@{
    ViewData["Title"] = "Schools";
}


<section class="sa-schools-page">

    <!-- HEADER -->

    <section class="sa-schools-header">

        <div>

            <span class="sa-page-label">
                School Management
            </span>

            <h2>
                All Schools
            </h2>

            <p>
                View and manage schools registered
                on the School-Parental System.
            </p>

        </div>


        <a asp-controller="SuperAdmin"
           asp-action="AddSchool"
           class="super-primary-button">

            <i class="bi bi-building-add"></i>

            Add School

        </a>

    </section>


    <!-- SUMMARY -->

    <section class="sa-schools-summary">

        <article class="sa-school-summary-card">

            <div class="sa-school-summary-icon total">
                <i class="bi bi-buildings-fill"></i>
            </div>

            <div>
                <span>Total Schools</span>

                <strong>
                    @Model.Schools.Count
                </strong>
            </div>

        </article>


        <article class="sa-school-summary-card">

            <div class="sa-school-summary-icon active">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>
                <span>Active</span>

                <strong>
                    @Model.Schools.Count(x =>
                    x.Status.Equals(
                    "Active",
                    StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>

        </article>


        <article class="sa-school-summary-card">

            <div class="sa-school-summary-icon pending">
                <i class="bi bi-clock-fill"></i>
            </div>

            <div>
                <span>Pending</span>

                <strong>
                    @Model.Schools.Count(x =>
                                        x.Status.Equals(
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>

        </article>


        <article class="sa-school-summary-card">

            <div class="sa-school-summary-icon inactive">
                <i class="bi bi-x-circle-fill"></i>
            </div>

            <div>
                <span>Inactive</span>

                <strong>
                    @Model.Schools.Count(x =>
                                        x.Status.Equals(
                                        "Inactive",
                                        StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>

        </article>

    </section>


    <!-- SCHOOL TABLE -->

    <section class="sa-schools-card">

        <div class="sa-schools-toolbar">

            <div>

                <h3>
                    Registered Schools
                </h3>

                <span>
                    @Model.Schools.Count school(s)
                </span>

            </div>


            <div class="sa-school-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="schoolSearch"
                       placeholder="Search schools..." />

            </div>

        </div>


        @if (Model.Schools.Count > 0)
        {
            <div class="sa-schools-table-wrapper">

                <table class="sa-schools-table">

                    <thead>

                        <tr>
                            <th>School</th>
                            <th>Code</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Learners</th>
                            <th>Principal</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var school in Model.Schools)
                        {
                            <tr class="school-row"
                                data-school="@(
                                (
                                    school.SchoolName + " " +
                                    school.SchoolCode + " " +
                                    school.TownCity + " " +
                                    school.Province
                                ).ToLowerInvariant())">

                        <td>

                            <div class="sa-school-name-cell">

                                <div class="sa-school-table-icon">

                                    <i class="bi bi-buildings-fill"></i>

                                </div>


                                <div>

                                    <strong>
                                        @school.SchoolName
                                    </strong>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(
                                                    school.Email)
                                                    ? "No email"
                                                    : school.Email)
                                                               </span>

                                </div>

                            </div>

                        </td>


                        <td>
                            @(string.IsNullOrWhiteSpace(
                            school.SchoolCode)
                            ? "—"
                            : school.SchoolCode)
                                            </td>


                        <td>

                            <strong>
                                @(string.IsNullOrWhiteSpace(
                                    school.TownCity)
                                    ? "—"
                                    : school.TownCity)
                                                  </strong>

                            <span class="sa-table-secondary">
                                @school.Province
                            </span>

                        </td>


                        <td>
                            @(string.IsNullOrWhiteSpace(
                            school.SchoolType)
                            ? "—"
                            : school.SchoolType)
                                            </td>


                        <td>
                            @school.LearnerCount
                        </td>


                        <td>
                            @(string.IsNullOrWhiteSpace(
                            school.PrincipalName)
                            ? "—"
                            : school.PrincipalName)
                        </td>


                                <td>

                            @{
                                        var statusClass =
                                        school.Status
                                        .ToLowerInvariant();
                                    }

                                    <span class="sa-school-status-pill
                                                         @statusClass">

                                        <span></span>

                                        @school.Status

                                    </span>

                                </td>


                                <td>

                                    <div class="sa-school-actions">

                                        <a asp-controller="SuperAdmin"
                                           asp-action="SchoolDetails"
                                           asp-route-id="@school.Id"
                                           class="sa-school-action-button"
                                           title="View school">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <a asp-controller="SuperAdmin"
                                            asp-action="EditSchool"
                                            asp-route-id="@school.Id"
                                            class="sa-school-action-button"
                                            title="Edit school">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</section>


@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const search =
                    document.getElementById(
                        "schoolSearch");

                const rows =
                    document.querySelectorAll(
                        ".school-row");


                if (!search) {
                    return;
                }


                search.addEventListener(
                    "input",
                    function () {

                        const term =
                            search.value
                                .trim()
                                .toLowerCase();


                        rows.forEach(
                            function (row) {

                                const value =
                                    row.dataset.school || "";

                                row.style.display =
                                    value.includes(term)
                                        ? ""
                                        : "none";
                            });
                    });
            });
    </script>
}