@model SchoolParentalSystem.Web.ViewModels.SuperAdmin.SchoolDetailsViewModel

@{
    ViewData["Title"] = "School Details";

    var statusClass =
        Model.Status.ToLowerInvariant();
}


<section class="sa-school-details-page">

    <!-- HEADER -->

    <section class="sa-school-details-header">

        <div>

            <a asp-controller="SuperAdmin"
               asp-action="Schools"
               class="sa-back-link">

                <i class="bi bi-arrow-left"></i>
                Back to Schools

            </a>

            <span class="sa-page-label">
                School Management
            </span>

            <h2>
                @Model.SchoolName
            </h2>

            <div class="sa-school-details-meta">

                <span class="sa-school-status-pill @statusClass">

                    <span></span>

                    @Model.Status

                </span>

                <span>
                    <i class="bi bi-geo-alt"></i>

                    @(string.IsNullOrWhiteSpace(Model.TownCity)
                                        ? Model.Address
                                        : $"{Model.TownCity}, {Model.Province}")
                </span>

            </div>

        </div>


        <a asp-controller="SuperAdmin"
           asp-action="EditSchool"
           asp-route-id="@Model.Id"
           class="super-primary-button">

            <i class="bi bi-pencil-square"></i>

            Edit School

        </a>

    </section>


    <!-- SUMMARY -->

    <section class="sa-school-details-summary">

        <article class="sa-school-detail-stat">

            <div class="sa-school-detail-stat-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <span>Active Learners</span>

                <strong>
                    @Model.LearnerCount
                </strong>
            </div>

        </article>


        <article class="sa-school-detail-stat">

            <div class="sa-school-detail-stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <span>Maximum Learners</span>

                <strong>
                    @(Model.MaxLearners?.ToString() ?? "—")
                </strong>
            </div>

        </article>


        <article class="sa-school-detail-stat">

            <div class="sa-school-detail-stat-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <span>Registered</span>

                <strong>
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </strong>
            </div>

        </article>

    </section>


    <!-- INFORMATION -->

    <section class="sa-school-details-grid">

        <article class="sa-school-details-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-buildings-fill"></i>

                <h3>
                    School Information
                </h3>

            </div>


            <div class="sa-detail-list">

                <div>
                    <span>School Name</span>
                    <strong>@Model.SchoolName</strong>
                </div>

                <div>
                    <span>School Code</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.SchoolCode)
                                                ? "—"
                                                : Model.SchoolCode)
                    </strong>
                </div>

                <div>
                    <span>Admission Prefix</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.AdmissionPrefix)
                                                ? "—"
                                                : Model.AdmissionPrefix)
                    </strong>
                </div>

                <div>
                    <span>School Type</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.SchoolType)
                                                ? "—"
                                                : Model.SchoolType)
                    </strong>
                </div>

                <div>
                    <span>Principal</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.PrincipalName)
                                                ? "—"
                                                : Model.PrincipalName)
                    </strong>
                </div>

            </div>

        </article>


        <article class="sa-school-details-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-geo-alt-fill"></i>

                <h3>
                    Location & Contact
                </h3>

            </div>


            <div class="sa-detail-list">

                <div>
                    <span>Address</span>
                    <strong>@Model.Address</strong>
                </div>

                <div>
                    <span>Town / City</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.TownCity)
                                                ? "—"
                                                : Model.TownCity)
                    </strong>
                </div>

                <div>
                    <span>Province</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Province)
                                                ? "—"
                                                : Model.Province)
                    </strong>
                </div>

                <div>
                    <span>Phone</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Phone)
                                                ? "—"
                                                : Model.Phone)
                    </strong>
                </div>

                <div>
                    <span>Email</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Email)
                                                ? "—"
                                                : Model.Email)
                    </strong>
                </div>

            </div>

        </article>

    </section>


    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <section class="sa-school-details-card
                            sa-school-notes-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-journal-text"></i>

                <h3>
                    Notes
                </h3>

            </div>

            <p>
                @Model.Notes
            </p>

        </section>
    }

</section>