@model SchoolParentalSystem.Web.ViewModels.SuperAdmin.EditSchoolViewModel

@{
    ViewData["Title"] = "Edit School";
}

<section class="sa-edit-school-page">

    <div class="sa-schools-header">

        <div>

            <a asp-controller="SuperAdmin"
               asp-action="SchoolDetails"
               asp-route-id="@Model.Id"
               class="sa-back-link">

                <i class="bi bi-arrow-left"></i>
                Back to School Details

            </a>

            <span class="sa-page-label"
                  style="display:block; margin-top:12px;">
                School Management
            </span>

            <h2>Edit School</h2>

            <p>
                Update the information for
                <strong>@Model.SchoolName</strong>.
            </p>

        </div>

    </div>


    <form asp-controller="SuperAdmin"
          asp-action="EditSchool"
          method="post"
          class="sa-edit-school-form">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>


        <!-- SCHOOL INFORMATION -->

        <section class="sa-school-details-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-buildings-fill"></i>

                <h3>School Information</h3>

            </div>


            <div class="sa-edit-form-grid">

                <div class="sa-edit-field">

                    <label asp-for="SchoolName">
                        School Name
                    </label>

                    <input asp-for="SchoolName" />

                    <span asp-validation-for="SchoolName"
                          class="text-danger">
                    </span>

                </div>


                <div class="sa-edit-field">

                    <label asp-for="SchoolCode">
                        School Code
                    </label>

                    <input asp-for="SchoolCode" />

                </div>


                <div class="sa-edit-field">

                    <label asp-for="AdmissionPrefix">
                        Admission Prefix
                    </label>

                    <input asp-for="AdmissionPrefix" />

                </div>


                <div class="sa-edit-field">

                    <label asp-for="SchoolType">
                        School Type
                    </label>

                    <select asp-for="SchoolType">

                        <option value="">
                            Select school type
                        </option>

                        @foreach (var type in Model.SchoolTypes)
                        {
                            <option value="@type">
                                @type
                            </option>
                        }

                    </select>

                </div>


                <div class="sa-edit-field">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status">

                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status">
                                @status
                            </option>
                        }

                    </select>

                </div>


                <div class="sa-edit-field">

                    <label asp-for="MaxLearners">
                        Maximum Learners
                    </label>

                    <input asp-for="MaxLearners"
                           type="number" />

                </div>

            </div>

        </section>


        <!-- LOCATION -->

        <section class="sa-school-details-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-geo-alt-fill"></i>

                <h3>Location</h3>

            </div>


            <div class="sa-edit-form-grid">

                <div class="sa-edit-field sa-edit-full">

                    <label asp-for="Address">
                        Address
                    </label>

                    <input asp-for="Address" />

                    <span asp-validation-for="Address"
                          class="text-danger">
                    </span>

                </div>


                <div class="sa-edit-field">

                    <label asp-for="TownCity">
                        Town / City
                    </label>

                    <input asp-for="TownCity" />

                </div>


                <div class="sa-edit-field">

                    <label asp-for="Province">
                        Province
                    </label>

                    <select asp-for="Province">

                        <option value="">
                            Select province
                        </option>

                        @foreach (var province in Model.Provinces)
                        {
                            <option value="@province">
                                @province
                            </option>
                        }

                    </select>

                </div>

            </div>

        </section>


        <!-- CONTACT -->

        <section class="sa-school-details-card">

            <div class="sa-detail-card-header">

                <i class="bi bi-person-lines-fill"></i>

                <h3>Contact & Administration</h3>

            </div>


            <div class="sa-edit-form-grid">

                <div class="sa-edit-field">

                    <label asp-for="PrincipalName">
                        Principal Name
                    </label>

                    <input asp-for="PrincipalName" />

                </div>


                <div class="sa-edit-field">

                    <label asp-for="Phone">
                        Phone
                    </label>

                    <input asp-for="Phone" />

                </div>


                <div class="sa-edit-field">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="sa-edit-field sa-edit-full">

                    <label asp-for="Notes">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              rows="4">
                    </textarea>

                </div>

            </div>

        </section>


        <div class="sa-edit-actions">

            <a asp-controller="SuperAdmin"
               asp-action="SchoolDetails"
               asp-route-id="@Model.Id"
               class="sa-edit-cancel-button">

                Cancel

            </a>


            <button type="submit"
                    class="super-primary-button">

                <i class="bi bi-check-lg"></i>

                Save Changes

            </button>

        </div>

    </form>

</section>