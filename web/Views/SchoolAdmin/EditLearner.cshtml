@model SchoolParentalSystem.Web.ViewModels.EditLearnerViewModel

@{
    ViewData["Title"] = "Edit Learner";
    Layout = "_SchoolAdminLayout";
}

<section class="dashboard-content">

    <div class="page-heading">
        <div>
            <h2>Edit Learner</h2>
            <p>Register a new learner for your school.</p>
        </div>

        <a class="secondary-action"
           asp-controller="SchoolAdmin"
           asp-action="Learners">
            <i class="bi bi-arrow-left"></i>
            Back to Learners
        </a>
    </div>

    <form asp-action="EditLearner"
          method="post"
          class="learner-form"
    input asp-for="Id" type="hidden" >

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <section class="form-card">

            <div class="form-section-header">
                <i class="bi bi-person-vcard"></i>

                <div>
                    <h3>Learner Information</h3>
                    <p>Enter the learner's personal and school details.</p>
                </div>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="AdmissionNumber"></label>
                    <input asp-for="AdmissionNumber"
                           placeholder="e.g. GF-2026-005" />
                    <span asp-validation-for="AdmissionNumber"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName"
                           placeholder="Enter learner full name" />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DateOfBirth"></label>
                    <input asp-for="DateOfBirth" />
                    <span asp-validation-for="DateOfBirth"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Gender"></label>

                    <select asp-for="Gender">
                        <option value="">Select gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>

                    <span asp-validation-for="Gender"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Grade"></label>

                    <select asp-for="Grade">
                        <option value="">Select grade</option>
                        <option>Grade 8</option>
                        <option>Grade 9</option>
                        <option>Grade 10</option>
                        <option>Grade 11</option>
                        <option>Grade 12</option>
                    </select>

                    <span asp-validation-for="Grade"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClassName"></label>

                    <select asp-for="ClassName">
                        <option value="">Select class</option>
                        <option>Grade 8 A</option>
                        <option>Grade 9 A</option>
                        <option>Grade 10 A</option>
                        <option>Grade 11 A</option>
                        <option>Grade 12 A</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Address"></label>

                    <textarea asp-for="Address"
                              rows="3"
                              placeholder="Enter home address"></textarea>
                </div>

            </div>

        </section>

        <section class="form-card">

            <div class="form-section-header">
                <i class="bi bi-person-hearts"></i>

                <div>
                    <h3>Guardian Information</h3>
                    <p>Link guardian details to this learner.</p>
                </div>
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="GuardianName"></label>
                    <input asp-for="GuardianName"
                           placeholder="Guardian full name" />
                </div>

                <div class="form-group">
                    <label asp-for="Relationship"></label>

                    <select asp-for="Relationship">
                        <option value="">Select relationship</option>
                        <option>Mother</option>
                        <option>Father</option>
                        <option>Guardian</option>
                        <option>Grandparent</option>
                        <option>Other</option>
                    </select>
                </div>

            </div>

        </section>

        <div class="form-actions">

            <a class="cancel-button"
               asp-controller="SchoolAdmin"
               asp-action="Learners">
                Cancel
            </a>

            <button type="submit"
                    class="primary-action">

                <i class="bi bi-check-circle-fill"></i>
                Save Changes

            </button>

        </div>

    </form>

</section>