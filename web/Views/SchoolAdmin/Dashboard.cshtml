@model SchoolParentalSystem.Web.ViewModels.SchoolAdminDashboardViewModel

@{
    ViewData["Title"] = "School Admin Dashboard";
    Layout = "_SchoolAdminLayout";
}

<!-- CONTENT -->
<section class="dashboard-content">

    <!-- WELCOME -->
    <div class="welcome-card">
        <h2>Welcome back, @Model.AdminName!</h2>

        <p>
            Here's what's happening at
            <strong>@Model.SchoolName</strong>
            today.
        </p>
    </div>

    <!-- STATS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <small>Total Learners</small>
                <h3>@Model.TotalLearners.ToString("N0")</h3>
                <span class="positive">↑ 12%</span>
                <span class="muted">vs last month</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-person-fill"></i>
            </div>

            <div>
                <small>Total Teachers</small>
                <h3>@Model.TotalTeachers</h3>
                <span class="positive">↑ 4%</span>
                <span class="muted">vs last month</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-easel-fill"></i>
            </div>

            <div>
                <small>Total Classes</small>
                <h3>@Model.TotalClasses</h3>
                <span class="positive">↑ 0%</span>
                <span class="muted">vs last month</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-pie-chart-fill"></i>
            </div>

            <div>
                <small>Attendance Rate</small>
                <h3>@Model.AttendanceRate%</h3>
                <span class="positive">↑ 2.1%</span>
                <span class="muted">vs last month</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon pink">
                <i class="bi bi-megaphone-fill"></i>
            </div>

            <div>
                <small>Active Announcements</small>
                <h3>@Model.ActiveAnnouncements</h3>
                <span class="positive">↑ 50%</span>
                <span class="muted">vs last month</span>
            </div>
        </div>

    </div>

    <!-- MIDDLE GRID -->
    <div class="dashboard-grid three-columns">

        <!-- ATTENDANCE -->
        <section class="panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-calendar3"></i>
                    Attendance Overview
                </h3>

                <a href="#">View All</a>
            </div>

            <div class="attendance-chart">

                @foreach (var item in Model.AttendanceOverview)
                {
                    <div class="bar-column">

                        <span class="percentage">
                            @item.Percentage%
                        </span>

                        <div class="bar-track">

                            <div class="bar-fill"
                                 style="height:@item.Percentage%;">
                            </div>

                        </div>

                        <span class="bar-label">
                            @item.Date
                        </span>

                    </div>
                }

            </div>

        </section>

        <!-- ANNOUNCEMENTS -->
        <section class="panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-megaphone-fill"></i>
                    Recent Announcements
                </h3>

                <a href="#">View All</a>
            </div>

            <div class="announcement-list">

                @foreach (var announcement in Model.RecentAnnouncements)
                {
                    <div class="announcement-row">

                        <div class="small-icon announcement">
                            <i class="bi bi-megaphone-fill"></i>
                        </div>

                        <div>
                            <strong>@announcement.Title</strong>
                            <p>@announcement.Description</p>
                        </div>

                    </div>
                }

            </div>

        </section>

        <!-- EVENTS -->
        <section class="panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-calendar-event-fill"></i>
                    Upcoming Events
                </h3>

                <a href="#">View All</a>
            </div>

            <div class="events-list">

                @foreach (var item in Model.UpcomingEvents)
                {
                    <div class="event-row">

                        <div class="event-date">
                            <span>@item.Month</span>
                            <strong>@item.Day</strong>
                        </div>

                        <span>@item.Title</span>

                    </div>
                }

            </div>

        </section>

    </div>

    <!-- BOTTOM GRID -->
    <div class="dashboard-grid bottom-grid">

        <!-- ACTIVITY -->
        <section class="panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-lightning-charge-fill"></i>
                    Recent Activity
                </h3>

                <a href="#">View All</a>
            </div>

            <div class="activity-list">

                @foreach (var activity in Model.RecentActivities)
                {
                    <div class="activity-row">

                        <div class="activity-dot"></div>

                        <span class="activity-text">
                            @activity.Description
                        </span>

                        <span class="activity-time">
                            @activity.TimeAgo
                        </span>

                    </div>
                }

            </div>

        </section>

        <!-- QUICK ACTIONS -->
        <section class="panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-rocket-takeoff-fill"></i>
                    Quick Actions
                </h3>
            </div>

            <div class="quick-actions">

                <a class="quick-action blue-action" href="#">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>
                        <strong>Add Learner</strong>
                        <small>Register a new learner</small>
                    </span>
                </a>

                <a class="quick-action green-action" href="#">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>
                        <strong>Add Teacher</strong>
                        <small>Create a teacher account</small>
                    </span>
                </a>

                <a class="quick-action purple-action" href="#">
                    <i class="bi bi-megaphone-fill"></i>
                    <span>
                        <strong>Create Announcement</strong>
                        <small>Send updates to parents</small>
                    </span>
                </a>

                <a class="quick-action orange-action" href="#">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                    <span>
                        <strong>Generate Report</strong>
                        <small>Attendance and grades</small>
                    </span>
                </a>

            </div>

        </section>

        <!-- PERFORMANCE -->
        <section class="panel performance-panel">

            <div class="panel-header">
                <h3>
                    <i class="bi bi-bar-chart-fill"></i>
                    Class Performance (Average Grade)
                </h3>

                <a href="#">View All</a>
            </div>

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Learners</th>
                            <th>Average Grade</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ClassPerformance)
                        {
                            <tr>

                                <td>@item.ClassName</td>

                                <td>@item.LearnerCount</td>

                                <td>@item.AverageGrade%</td>

                                <td>
                                    <span class="status-dot
                                        @(item.Status == "Needs attention"
                                            ? "warning"
                                            : "good")">
                                    </span>

                                    @item.Status
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </div>

</section>
