
@using System.Linq
@model SchoolParentalSystem.Web.ViewModels.CommunicationStatisticsViewModel

@{
    ViewData["Title"] = "Communication Statistics";
    Layout = "_SchoolAdminLayout";

    var maxMonthlyCount = Math.Max(
        1,
        Model.MonthlyActivity
            .Select(x => Math.Max(x.Announcements, x.Events))
            .DefaultIfEmpty(0)
            .Max());
}

<link rel="stylesheet"
      href="~/css/school-admin-communication-statistics.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/school-admin-communication.css"
      asp-append-version="true" />

<main class="cs-page">

    <!-- PAGE HEADING -->

    <div class="cs-heading">
        <div>
            <h2>Communication Statistics</h2>
            <p>
                Monitor school announcements,
                engagement and event activity.
            </p>
        </div>
    </div>

    <!-- COMMUNICATION TABS -->

    <div class="communication-tabs">

        <a asp-controller="SchoolAdmin"
           asp-action="Communication"
           class="communication-tab">

            <i class="bi bi-megaphone"></i>
            Announcements

        </a>


        <a asp-controller="SchoolAdmin"
           asp-action="Events"
           class="communication-tab">

            <i class="bi bi-calendar-event"></i>
            Events

        </a>



        <a asp-controller="SchoolAdmin"
           asp-action="CommunicationStatistics"
           class="communication-tab active">

            <i class="bi bi-bar-chart"></i>
            Statistics

        </a>


    </div>

    <!-- ANNOUNCEMENT OVERVIEW -->

    <div class="cs-section-title">
        <h3>Announcement Overview</h3>
        <p>All announcements belonging to your school</p>
    </div>

    <div class="cs-stats-grid">

        <div class="cs-stat-card">
            <div class="cs-stat-icon green">
                <i class="bi bi-megaphone"></i>
            </div>

            <span>Total Announcements</span>
            <strong>@Model.TotalAnnouncements</strong>
            <small>All published announcements</small>
        </div>

        <div class="cs-stat-card">
            <div class="cs-stat-icon gold">
                <i class="bi bi-check-circle"></i>
            </div>

            <span>Active Announcements</span>
            <strong>@Model.ActiveAnnouncements</strong>
            <small>Not yet expired</small>
        </div>

        <div class="cs-stat-card">
            <div class="cs-stat-icon muted">
                <i class="bi bi-clock-history"></i>
            </div>

            <span>Expired Announcements</span>
            <strong>@Model.ExpiredAnnouncements</strong>
            <small>Past their expiry date</small>
        </div>

    </div>

    <!-- ENGAGEMENT -->

    <div class="cs-section-title">
        <h3>Recipient Engagement</h3>
        <p>Read activity and acknowledgement progress</p>
    </div>

    <div class="cs-two-column">

        <section class="cs-panel">

            <div class="cs-panel-heading">
                <h4>Announcement Read Rate</h4>
                <i class="bi bi-eye"></i>
            </div>

            <div class="cs-large-percentage">
                @Model.ReadRatePercent.ToString("0.0")%
            </div>

            <div class="cs-progress-track">
                <div class="cs-progress-fill"
                     style="width: @(Model.ReadRatePercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>

            <div class="cs-detail-row">
                <span>Read recipient records</span>
                <strong>@Model.ReadRecipients</strong>
            </div>

            <div class="cs-detail-row">
                <span>Unread recipient records</span>
                <strong>@Model.UnreadRecipients</strong>
            </div>

            <div class="cs-detail-row">
                <span>Total recipient records</span>
                <strong>@Model.TotalRecipients</strong>
            </div>

        </section>

        <section class="cs-panel">

            <div class="cs-panel-heading">
                <h4>Acknowledgement Rate</h4>
                <i class="bi bi-check2-all"></i>
            </div>

            <div class="cs-large-percentage">
                @Model.AcknowledgementRatePercent.ToString("0.0")%
            </div>

            <div class="cs-progress-track">
                <div class="cs-progress-fill gold"
                     style="width: @(Model.AcknowledgementRatePercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>

            <div class="cs-detail-row">
                <span>Acknowledged</span>
                <strong>@Model.AcknowledgedRecipients</strong>
            </div>

            <div class="cs-detail-row">
                <span>Pending acknowledgements</span>
                <strong>@Model.PendingAcknowledgements</strong>
            </div>

            <div class="cs-detail-row">
                <span>Required acknowledgements</span>
                <strong>@Model.AcknowledgementRequiredRecipients</strong>
            </div>

        </section>

    </div>

    <!-- PRIORITY AND EVENTS -->

    <div class="cs-two-column">

        <section class="cs-panel">

            <div class="cs-panel-heading">
                <h4>Announcement Priorities</h4>
                <i class="bi bi-flag"></i>
            </div>

            <div class="cs-detail-row">
                <span>
                    <i class="cs-dot normal"></i>
                    Normal
                </span>
                <strong>@Model.NormalAnnouncements</strong>
            </div>

            <div class="cs-detail-row">
                <span>
                    <i class="cs-dot important"></i>
                    Important
                </span>
                <strong>@Model.ImportantAnnouncements</strong>
            </div>

            <div class="cs-detail-row">
                <span>
                    <i class="cs-dot urgent"></i>
                    Urgent
                </span>
                <strong>@Model.UrgentAnnouncements</strong>
            </div>

        </section>

        <section class="cs-panel">

            <div class="cs-panel-heading">
                <h4>Event Overview</h4>
                <i class="bi bi-calendar3"></i>
            </div>

            <div class="cs-detail-row">
                <span>Total Events</span>
                <strong>@Model.TotalEvents</strong>
            </div>

            <div class="cs-detail-row">
                <span>Upcoming Events</span>
                <strong>@Model.UpcomingEvents</strong>
            </div>

            <div class="cs-detail-row">
                <span>Past Events</span>
                <strong>@Model.PastEvents</strong>
            </div>

        </section>

    </div>

    <!-- MONTHLY ACTIVITY -->

    <section class="cs-panel cs-activity-panel">

        <div class="cs-panel-heading">
            <div>
                <h4>Monthly Communication Activity</h4>
                <p>
                    Announcements created and events scheduled
                    over the last six calendar months
                </p>
            </div>
            <i class="bi bi-graph-up"></i>
        </div>

        <div class="cs-chart-legend">
            <span>
                <i class="cs-dot normal"></i>
                Announcements
            </span>

            <span>
                <i class="cs-dot important"></i>
                Events
            </span>
        </div>

        <div class="cs-monthly-chart">

            @foreach (var month in Model.MonthlyActivity)
            {
                var announcementHeight =
                    Math.Round(
                        month.Announcements * 100.0
                        / maxMonthlyCount);

                var eventHeight =
                    Math.Round(
                        month.Events * 100.0
                        / maxMonthlyCount);

                <div class="cs-month">

                    <div class="cs-bars">

                        <div class="cs-bar announcement"
                             style="height: @(announcementHeight)%"
                             title="@month.Announcements announcements"
                             role="img"
                             aria-label="@month.MonthLabel: @month.Announcements announcements">
                        </div>

                        <div class="cs-bar event"
                             style="height: @(eventHeight)%"
                             title="@month.Events events"
                             role="img"
                             aria-label="@month.MonthLabel: @month.Events events">
                        </div>

                    </div>

                    <div class="cs-month-label">
                        @month.MonthLabel
                    </div>

                    <div class="cs-month-counts">
                        @month.Announcements / @month.Events
                    </div>

                </div>
            }

        </div>

    </section>

</main>
