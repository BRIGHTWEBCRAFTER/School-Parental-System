@model SchoolParentalSystem.Web.ViewModels.LearnerDetailsViewModel

@{
    ViewData["Title"] = "Learner Details";
    Layout = "_SchoolAdminLayout";
}

<section class="dashboard-content">

    <div class="page-heading">

        <div>
            <h2>Learner Details</h2>
            <p>View learner, school and guardian information.</p>
        </div>

        <div class="details-heading-actions">

            <a class="secondary-action"
               asp-action="Learners">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a class="primary-action"
               asp-action="EditLearner"
               asp-route-id="@Model.Id">
                <i class="bi bi-pencil-square"></i>
                Edit Learner
            </a>

            @if (Model.IsActive)
            {
                <button type="button"
                        class="danger-action"
                        id="openDeactivateModal">

                    <i class="bi bi-person-dash-fill"></i>
                    Deactivate Learner

                </button>
            }
            else
            {
                <form asp-action="ReactivateLearner"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="inline-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="reactivate-action">
                        <i class="bi bi-person-check-fill"></i>
                        Reactivate Learner
                    </button>

                </form>
            }

        </div>

    </div>


    <div class="learner-profile-card">

        <div>
            <label>Full Name</label>
            <strong>@Model.FullName</strong>
        </div>

        <div>
            <label>Admission Number</label>
            <strong>@Model.AdmissionNumber</strong>
        </div>

        <div>
            <label>Date of Birth</label>
            <strong>
                @(Model.DateOfBirth.HasValue
                    ? Model.DateOfBirth.Value.ToString("dd MMMM yyyy")
                    : "Not provided")
            </strong>
        </div>

        <div>
            <label>Gender</label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.Gender)
                    ? "Not provided"
                    : Model.Gender)
            </strong>
        </div>

        <div>
            <label>Grade</label>
            <strong>@Model.Grade</strong>
        </div>

        <div>
            <label>Class</label>
            <strong>@Model.ClassName</strong>
        </div>

        <div>
            <label>Address</label>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.Address)
                    ? "Not provided"
                    : Model.Address)
            </strong>
        </div>

        <div>
            <label>Status</label>

            @if (Model.IsActive)
            {
                <span class="status-badge active">
                    Active
                </span>
            }
            else
            {
                <span class="status-badge inactive">
                    Inactive
                </span>
            }
        </div>

    </div>


    <div class="details-grid">

        <section class="form-card">

            <div class="form-section-header">
                <i class="bi bi-person-vcard"></i>

                <div>
                    <h3>Personal Information</h3>
                    <p>Learner personal and school details.</p>
                </div>
            </div>

            <div class="information-grid">

                <div class="information-item">
                    <span>Admission Number</span>
                    <strong>@Model.AdmissionNumber</strong>
                </div>

                <div class="information-item">
                    <span>Full Name</span>
                    <strong>@Model.FullName</strong>
                </div>

                <div class="information-item">
                    <span>Date of Birth</span>
                    <strong>
                        @(Model.DateOfBirth.HasValue
                            ? Model.DateOfBirth.Value.ToString("dd MMMM yyyy")
                            : "Not provided")
                    </strong>
                </div>

                <div class="information-item">
                    <span>Gender</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Gender)
                            ? "Not provided"
                            : Model.Gender)
                    </strong>
                </div>

                <div class="information-item">
                    <span>Grade</span>
                    <strong>@Model.Grade</strong>
                </div>

                <div class="information-item">
                    <span>Class</span>
                    <strong>@Model.ClassName</strong>
                </div>

                <div class="information-item full-information-item">
                    <span>Address</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "Not provided"
                            : Model.Address)
                    </strong>
                </div>

            </div>

        </section>


        <section class="form-card">

            <div class="form-section-header">
                <i class="bi bi-people-fill"></i>

                <div>
                    <h3>Guardian Information</h3>
                    <p>Registered parent or guardian linked to this learner.</p>
                </div>
            </div>

            <div class="information-grid">

                <div class="information-item">
                    <span>Parent / Guardian</span>
                    <strong>@Model.GuardianName</strong>
                </div>

                <div class="information-item">
                    <span>Guardian Number</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.GuardianNumber)
                            ? "Not available"
                            : Model.GuardianNumber)
                    </strong>
                </div>

                <div class="information-item">
                    <span>Relationship</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Relationship)
                            ? "Not available"
                            : Model.Relationship)
                    </strong>
                </div>

                <div class="information-item">
                    <span>Phone Number</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.GuardianPhone)
                            ? "Not provided"
                            : Model.GuardianPhone)
                    </strong>
                </div>

                <div class="information-item full-information-item">
                    <span>Email Address</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.GuardianEmail)
                            ? "Not provided"
                            : Model.GuardianEmail)
                    </strong>
                </div>

            </div>

        </section>

    </div>

    

</section>

@if (Model.IsActive)
{
    <div id="deactivateModal"
         class="confirmation-overlay">

        <div class="confirmation-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deactivateModalTitle">

            <div class="confirmation-icon danger">
                <i class="bi bi-trash3-fill"></i>
            </div>

            <h3 id="deactivateModalTitle">
                Deactivate Learner?
            </h3>

            <p class="confirmation-message">
                Are you sure you want to deactivate this learner?
                The learner record will remain in the system,
                but they will no longer be active.
            </p>

            <div class="confirmation-learner">

                <span>Learner:</span>

                <strong>
                    @Model.FullName
                </strong>

            </div>

            <div class="confirmation-actions">

                <button type="button"
                        class="confirmation-cancel"
                        id="cancelDeactivate">

                    Cancel

                </button>


                <form asp-controller="SchoolAdmin"
                      asp-action="DeactivateLearner"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="confirmation-deactivate">
                        Deactivate
                    </button>

                </form>

            </div>

        </div>

    </div>
}

<script>
    const deactivateModal =
        document.getElementById("deactivateModal");

    const openDeactivateModal =
        document.getElementById("openDeactivateModal");

    const cancelDeactivate =
        document.getElementById("cancelDeactivate");


    if (openDeactivateModal && deactivateModal) {

        openDeactivateModal.addEventListener(
            "click",
            function () {

                deactivateModal.classList.add("show");

                document.body.classList.add(
                    "modal-open"
                );
            }
        );
    }


    if (cancelDeactivate && deactivateModal) {

        cancelDeactivate.addEventListener(
            "click",
            function () {

                closeDeactivateModal();
            }
        );
    }


    if (deactivateModal) {

        deactivateModal.addEventListener(
            "click",
            function (event) {

                if (event.target === deactivateModal) {

                    closeDeactivateModal();
                }
            }
        );
    }


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape" &&
                deactivateModal &&
                deactivateModal.classList.contains("show")) {

                closeDeactivateModal();
            }
        }
    );


    function closeDeactivateModal() {

        deactivateModal.classList.remove("show");

        document.body.classList.remove(
            "modal-open"
        );
    }
</script>