@model SchoolParentalSystem.Web.ViewModels.LearnerDetailsViewModel


@{
    ViewData["Title"] = "Learner Details";
    Layout = "_SchoolAdminLayout";

    var nameParts =
        (Model.FullName ?? "")
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

    var initials =
        string.Concat(
            nameParts
                .Take(2)
                .Select(x =>
                    char.ToUpperInvariant(x[0])));

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "?";
    }
}


<section class="dashboard-content">

    <!-- =====================================================
         PAGE HEADING / ACTIONS
         ===================================================== -->

    <div class="detail-page-heading">

        <div>

            <h2>Learner Details</h2>

            <p>
                View learner, school and guardian information.
            </p>

        </div>


        <div class="detail-heading-actions">

            <a asp-controller="SchoolAdmin"
               asp-action="Learners"
               class="detail-back-action">

                <i class="bi bi-arrow-left"></i>
                Back

            </a>


            <a asp-controller="SchoolAdmin"
               asp-action="EditLearner"
               asp-route-id="@Model.Id"
               class="detail-edit-action">

                <i class="bi bi-pencil-square"></i>
                Edit Learner

            </a>


            @if (Model.IsActive)
            {
                <button type="button"
                        class="detail-danger-action"
                        id="openDeactivateModal">

                    <i class="bi bi-person-dash-fill"></i>
                    Deactivate Learner

                </button>
            }
            else
            {
                <form asp-controller="SchoolAdmin"
                      asp-action="ReactivateLearner"
                      asp-route-id="@Model.Id"
                      asp-route-returnUrl="@Context.Request.Path"
                      method="post"
                      class="inline-form">

                    @Html.AntiForgeryToken()


                    <button type="submit"
                            class="detail-reactivate-action">

                        <i class="bi bi-person-check-fill"></i>
                        Reactivate Learner

                    </button>

                </form>
            }

        </div>

    </div>


    <!-- =====================================================
         LEARNER IDENTITY HERO
         ===================================================== -->

    <section class="detail-profile-hero">

        <div class="detail-avatar">

            @initials

        </div>


        <div class="detail-identity">

            <div class="detail-name-row">

                <h3>
                    @Model.FullName
                </h3>


                <span class="detail-status
                      @(Model.IsActive
                          ? "active"
                          : "inactive")">

                    @(Model.IsActive
                        ? "Active"
                        : "Inactive")

                </span>

            </div>


            <div class="detail-meta">

                <span>
                    @Model.AdmissionNumber
                </span>


                <span class="detail-meta-dot">
                    •
                </span>


                <span>
                    @Model.Grade
                </span>


                <span class="detail-meta-dot">
                    •
                </span>


                <span>
                    @Model.ClassName
                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MAIN INFORMATION AREA
         ===================================================== -->

    <div class="detail-content-grid">


        <!-- =================================================
             PERSONAL INFORMATION
             ================================================= -->

        <section class="detail-card">

            <div class="detail-card-header">

                <div class="detail-card-icon">

                    <i class="bi bi-person-vcard"></i>

                </div>


                <div>

                    <h3>
                        Personal Information
                    </h3>

                    <p>
                        Learner personal and academic details.
                    </p>

                </div>

            </div>


            <div class="detail-definition-grid">


                <!-- FULL NAME -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-person-badge"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Full Name
                        </span>

                        <strong class="detail-field-value">
                            @Model.FullName
                        </strong>

                    </div>

                </div>


                <!-- ADMISSION NUMBER -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-hash"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Admission Number
                        </span>

                        <strong class="detail-field-value">
                            @Model.AdmissionNumber
                        </strong>

                    </div>

                </div>


                <!-- DATE OF BIRTH -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-calendar3"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Date of Birth
                        </span>

                        <strong class="detail-field-value">

                            @(Model.DateOfBirth.HasValue
                                ? Model.DateOfBirth.Value
                                .ToString("dd MMMM yyyy")
                                : "Not provided")

                        </strong>

                    </div>

                </div>


                <!-- GENDER -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-person"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Gender
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.Gender)
                                ? "Not provided"
                                : Model.Gender)

                        </strong>

                    </div>

                </div>


                <!-- GRADE -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Grade
                        </span>

                        <strong class="detail-field-value">
                            @Model.Grade
                        </strong>

                    </div>

                </div>


                <!-- CLASS -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-people-fill"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Class
                        </span>

                        <strong class="detail-field-value">
                            @Model.ClassName
                        </strong>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="detail-field full-width">

                    <div class="detail-field-icon">

                        <i class="bi bi-geo-alt-fill"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Address
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.Address)
                                ? "Not provided"
                                : Model.Address)

                        </strong>

                    </div>

                </div>

            </div>

        </section>



        <!-- =================================================
             GUARDIAN INFORMATION
             ================================================= -->

        <aside class="detail-card">

            <div class="detail-card-header">

                <div class="detail-card-icon">

                    <i class="bi bi-people-fill"></i>

                </div>


                <div>

                    <h3>
                        Guardian Information
                    </h3>

                    <p>
                        Registered parent or guardian
                        linked to this learner.
                    </p>

                </div>

            </div>


            <div class="detail-side-fields">


                <!-- GUARDIAN NAME -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-person-fill"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Parent / Guardian
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.GuardianName)
                                ? "Not linked"
                                : Model.GuardianName)

                        </strong>

                    </div>

                </div>


                <!-- GUARDIAN NUMBER -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-person-vcard"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Guardian Number
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.GuardianNumber)
                                ? "Not available"
                                : Model.GuardianNumber)

                        </strong>

                    </div>

                </div>


                <!-- RELATIONSHIP -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-link-45deg"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Relationship
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.Relationship)
                                ? "Not available"
                                : Model.Relationship)

                        </strong>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-telephone"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Phone Number
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.GuardianPhone)
                                ? "Not provided"
                                : Model.GuardianPhone)

                        </strong>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="detail-field">

                    <div class="detail-field-icon">

                        <i class="bi bi-envelope"></i>

                    </div>


                    <div>

                        <span class="detail-field-label">
                            Email Address
                        </span>

                        <strong class="detail-field-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.GuardianEmail)
                                ? "Not provided"
                                : Model.GuardianEmail)

                        </strong>

                    </div>

                </div>

            </div>

        </aside>

    </div>

</section>



<!-- =========================================================
     DEACTIVATE CONFIRMATION MODAL
     ========================================================= -->
@if (Model.IsActive)
{
    <div id="deactivateModal"
         class="confirmation-overlay">

        <div class="confirmation-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deactivateModalTitle">


            <div class="confirmation-icon danger">

                <i class="bi bi-trash3-fill"></i>

            </div>


            <h3 id="deactivateModalTitle">

                Deactivate Learner?

            </h3>


            <p class="confirmation-message">

                Are you sure you want to deactivate this learner?
                The learner record will remain in the system,
                but they will no longer be active.

            </p>


            <div class="confirmation-learner">

                <span>
                    Learner:
                </span>

                <strong>
                    @Model.FullName
                </strong>

            </div>


            <div class="confirmation-actions">

                <button type="button"
                        class="confirmation-cancel"
                        id="cancelDeactivate">

                    Cancel

                </button>


                <form asp-controller="SchoolAdmin"
                      asp-action="DeactivateLearner"
                      asp-route-id="@Model.Id"
                      asp-route-returnUrl="@Context.Request.Path"
                      method="post">

                    @Html.AntiForgeryToken()


                    <button type="submit"
                            class="confirmation-deactivate">

                        Deactivate

                    </button>

                </form>

            </div>

        </div>

    </div>
}



<script>

    const deactivateModal =
        document.getElementById(
            "deactivateModal"
        );


    const openDeactivateModal =
        document.getElementById(
            "openDeactivateModal"
        );


    const cancelDeactivate =
        document.getElementById(
            "cancelDeactivate"
        );


    if (openDeactivateModal &&
        deactivateModal) {

        openDeactivateModal
            .addEventListener(
                "click",
                function () {

                    deactivateModal
                        .classList
                        .add("show");


                    document.body
                        .classList
                        .add("modal-open");

                }
            );
    }


    if (cancelDeactivate &&
        deactivateModal) {

        cancelDeactivate
            .addEventListener(
                "click",
                function () {

                    closeDeactivateModal();

                }
            );
    }


    if (deactivateModal) {

        deactivateModal
            .addEventListener(
                "click",
                function (event) {

                    if (event.target ===
                        deactivateModal) {

                        closeDeactivateModal();

                    }

                }
            );
    }


    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape" &&
                deactivateModal &&
                deactivateModal
                    .classList
                    .contains("show")) {

                closeDeactivateModal();

            }

        }
    );


    function closeDeactivateModal() {

        if (!deactivateModal) {
            return;
        }


        deactivateModal
            .classList
            .remove("show");


        document.body
            .classList
            .remove("modal-open");

    }

</script>