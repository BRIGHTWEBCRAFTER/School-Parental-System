@model SchoolParentalSystem.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Reset your School-Parental System password." />

    <title>
        Reset Password - School-Parental System
    </title>


    <!-- BOOTSTRAP ICONS -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- LOGIN / AUTH STYLES -->

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

</head>


<body>

    <div class="recovery-page">


        <section class="recovery-card">


            <!-- ICON -->

            <div class="recovery-icon">

                <i class="bi bi-shield-lock-fill"></i>

            </div>


            <!-- TITLE -->

            <h1>
                Create a new password
            </h1>


            <p class="recovery-description">
                Choose a secure new password for your
                School-Parental System account.
            </p>


            <!-- INVALID LINK MESSAGE -->

            <div id="invalidRecoveryMessage"
                 class="validation-summary"
                 style="display:none;">

                <i class="bi bi-exclamation-circle-fill"></i>

                <span>
                    This password reset link is invalid or has expired.
                    Please request a new password reset link.
                </span>

            </div>


            <!-- RESET FORM -->

            <form asp-controller="Auth"
                  asp-action="ResetPassword"
                  method="post"
                  id="resetPasswordForm">

                @Html.AntiForgeryToken()


                <!-- SUPABASE RECOVERY TOKENS -->

                <input asp-for="AccessToken"
                       type="hidden"
                       id="resetAccessToken" />

                <input asp-for="RefreshToken"
                       type="hidden"
                       id="resetRefreshToken" />


                <!-- SERVER VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- NEW PASSWORD -->

                <div class="login-form-group">

                    <label asp-for="NewPassword"></label>


                    <div class="login-input">

                        <i class="bi bi-lock"></i>


                        <input asp-for="NewPassword"
                               id="newPassword"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Enter new password" />


                        <button type="button"
                                class="password-toggle"
                                id="newPasswordToggle"
                                aria-label="Show password">

                            <i class="bi bi-eye-fill"></i>

                        </button>

                    </div>


                    <span asp-validation-for="NewPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="login-form-group">

                    <label asp-for="ConfirmPassword"></label>


                    <div class="login-input">

                        <i class="bi bi-lock-fill"></i>


                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Confirm new password" />


                        <button type="button"
                                class="password-toggle"
                                id="confirmPasswordToggle"
                                aria-label="Show password">

                            <i class="bi bi-eye-fill"></i>

                        </button>

                    </div>


                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- PASSWORD GUIDANCE -->

                <div class="recovery-password-info">

                    <i class="bi bi-info-circle-fill"></i>

                    <span>
                        Your password must contain at least
                        8 characters.
                    </span>

                </div>


                <!-- SUBMIT -->

                <button type="submit"
                        class="login-submit"
                        id="updatePasswordButton">

                    <span>
                        Update Password
                    </span>

                    <i class="bi bi-check-circle"></i>

                </button>


                <!-- BACK TO LOGIN -->

                <div class="recovery-login-link">

                    <a asp-controller="Auth"
                       asp-action="Login">

                        <i class="bi bi-arrow-left"></i>

                        Back to Log In

                    </a>

                </div>

            </form>

        </section>

    </div>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // ==========================================
                // SUPABASE RECOVERY TOKENS
                // ==========================================

                const accessInput =
                    document.getElementById(
                        "resetAccessToken"
                    );

                const refreshInput =
                    document.getElementById(
                        "resetRefreshToken"
                    );

                const invalidMessage =
                    document.getElementById(
                        "invalidRecoveryMessage"
                    );

                const submitButton =
                    document.getElementById(
                        "updatePasswordButton"
                    );


                // Existing values are important when the
                // server returns the page after validation.

                let accessToken =
                    accessInput.value;

                let refreshToken =
                    refreshInput.value;


                // On the first visit Supabase places the
                // recovery session in the URL fragment.

                if (window.location.hash) {

                    const values =
                        new URLSearchParams(
                            window.location.hash
                                .substring(1)
                        );


                    const hashAccessToken =
                        values.get(
                            "access_token"
                        );

                    const hashRefreshToken =
                        values.get(
                            "refresh_token"
                        );

                    const recoveryType =
                        values.get(
                            "type"
                        );


                    if (
                        recoveryType === "recovery" &&
                        hashAccessToken &&
                        hashRefreshToken
                    ) {

                        accessToken =
                            hashAccessToken;

                        refreshToken =
                            hashRefreshToken;


                        accessInput.value =
                            accessToken;

                        refreshInput.value =
                            refreshToken;


                        // Remove sensitive recovery tokens
                        // from the visible browser URL.

                        history.replaceState(
                            null,
                            document.title,
                            window.location.pathname +
                            window.location.search
                        );

                    }

                }


                // ==========================================
                // INVALID / EXPIRED LINK CHECK
                // ==========================================

                if (
                    !accessToken ||
                    !refreshToken
                ) {

                    invalidMessage.style.display =
                        "flex";

                    submitButton.disabled =
                        true;

                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );

                }


                // ==========================================
                // PASSWORD VISIBILITY
                // ==========================================

                function configureToggle(
                    inputId,
                    buttonId
                ) {

                    const input =
                        document.getElementById(
                            inputId
                        );

                    const button =
                        document.getElementById(
                            buttonId
                        );


                    if (!input || !button) {
                        return;
                    }


                    button.addEventListener(
                        "click",
                        function () {

                            const isVisible =
                                input.type ===
                                "text";


                            input.type =
                                isVisible
                                    ? "password"
                                    : "text";


                            button.innerHTML =
                                isVisible
                                    ? '<i class="bi bi-eye-fill"></i>'
                                    : '<i class="bi bi-eye-slash-fill"></i>';


                            button.setAttribute(
                                "aria-label",
                                isVisible
                                    ? "Show password"
                                    : "Hide password"
                            );

                        }
                    );

                }


                configureToggle(
                    "newPassword",
                    "newPasswordToggle"
                );


                configureToggle(
                    "confirmPassword",
                    "confirmPasswordToggle"
                );

            });

    </script>

</body>

</html>