@model SchoolParentalSystem.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - School-Parental System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

</head>

<body>

    <div class="recovery-page">

        <section class="recovery-card">

            <div class="recovery-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h1>Create a new password</h1>

            <p class="recovery-description">
                Choose a new password for your School-Parental System account.
            </p>

            <form asp-controller="Auth"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="AccessToken"
                       type="hidden"
                       id="resetAccessToken" />

                <input asp-for="RefreshToken"
                       type="hidden"
                       id="resetRefreshToken" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <div class="login-form-group">

                    <label asp-for="NewPassword"></label>

                    <div class="login-input">

                        <i class="bi bi-lock"></i>

                        <input asp-for="NewPassword"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <div class="login-form-group">

                    <label asp-for="ConfirmPassword"></label>

                    <div class="login-input">

                        <i class="bi bi-lock-fill"></i>

                        <input asp-for="ConfirmPassword"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <button type="submit"
                        class="login-submit">

                    <span>Update Password</span>

                    <i class="bi bi-check-circle"></i>

                </button>

            </form>

        </section>

    </div>


    <script>
        /*
            Supabase recovery links return the recovery session
            in the URL fragment.

            Example:
            #access_token=...&refresh_token=...&type=recovery
        */

        const hash =
            window.location.hash.substring(1);

        const values =
            new URLSearchParams(hash);

        const accessToken =
            values.get("access_token");

        const refreshToken =
            values.get("refresh_token");

        if (accessToken && refreshToken) {

            document.getElementById(
                "resetAccessToken"
            ).value = accessToken;

            document.getElementById(
                "resetRefreshToken"
            ).value = refreshToken;

            // Remove sensitive tokens from the visible URL.
            history.replaceState(
                null,
                document.title,
                window.location.pathname
            );
        }
    </script>

</body>
</html>