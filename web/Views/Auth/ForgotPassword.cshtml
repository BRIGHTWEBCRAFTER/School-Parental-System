@model SchoolParentalSystem.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password - School-Parental System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>

    <div class="recovery-page">

        <section class="recovery-card">

            <a asp-controller="Auth"
               asp-action="Login"
               class="recovery-back">
                <i class="bi bi-arrow-left"></i>
                Back to login
            </a>

            <div class="recovery-icon">
                <i class="bi bi-key-fill"></i>
            </div>

            <h1>Forgot your password?</h1>

            <p class="recovery-description">
                Enter the email address linked to your school account.
                We'll send you a secure password reset link.
            </p>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="recovery-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@ViewBag.SuccessMessage</span>
                </div>
            }

            <form asp-controller="Auth"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="login-form-group">

                    <label asp-for="Email"></label>

                    <div class="login-input">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Email"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="field-validation-error">
                    </span>

                </div>

                <button type="submit"
                        class="login-submit">

                    <span>Send Reset Link</span>

                    <i class="bi bi-send"></i>

                </button>

            </form>

            <p class="recovery-help">
                Remember your password?
                <a asp-controller="Auth"
                   asp-action="Login">
                    Log in
                </a>
            </p>

        </section>

    </div>

</body>
</html>