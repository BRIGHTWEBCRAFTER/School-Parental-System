@model SchoolParentalSystem.Web.ViewModels.Teacher.TeacherProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_TeacherLayout";
}

<link rel="stylesheet"
      href="~/css/school-admin-profile.css"
      asp-append-version="true" />

<style>
    /* TEACHER PROFILE ADJUSTMENTS */

    .teacher-profile-page .sa-profile-hero,
    .teacher-profile-page .sa-profile-card {
        min-width: 0;
    }

    .teacher-profile-page .sa-profile-field strong,
    .teacher-profile-page .sa-profile-identity p {
        overflow-wrap: anywhere;
    }

    .teacher-profile-page .sa-profile-upload-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .teacher-profile-page .sa-profile-picture-input {
        display: block;
        max-width: 100%;
    }

    .teacher-profile-page .sa-profile-upload-hint {
        color: #718078;
        font-size: 12px;
    }

    .teacher-profile-page .teacher-profile-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        margin-top: 14px;
        border: 1px solid #dce9df;
        background: #f0f7f2;
        border-radius: 9px;
        color: #315d49;
        font-size: 13px;
        line-height: 1.6;
    }

    .teacher-profile-page .sa-profile-upload-button,
    .teacher-profile-page .sa-profile-remove-button {
        cursor: pointer;
    }

    .teacher-profile-page .sa-profile-avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>


<section class="dashboard-content sa-profile-page teacher-profile-page">

    <!-- PAGE HEADING -->

    <div class="sa-profile-heading">
        <div>
            <h2>My Profile</h2>

            <p>
                View your Teacher account information
                and manage your security settings.
            </p>
        </div>
    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"
             role="status">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["SuccessMessage"]

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- ==========================================
         PROFILE OVERVIEW
         ========================================== -->

    <div class="sa-profile-hero">

        <!-- PROFILE AVATAR -->

        <div class="sa-profile-avatar">

            @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
            {
                <img src="@Model.ProfilePicture"
                     alt="Profile picture of @Model.FullName"
                     class="sa-profile-avatar-image" />
            }
            else
            {
                @Model.Initials
            }

        </div>


        <!-- TEACHER IDENTITY -->

        <div class="sa-profile-identity">

            <h3>@Model.FullName</h3>

            <div class="sa-profile-role">

                <i class="bi bi-mortarboard"></i>

                @Model.Role

            </div>

            <p>

                <i class="bi bi-building"></i>

                @Model.SchoolName

            </p>

            <p>

                <i class="bi bi-envelope"></i>

                @(string.IsNullOrWhiteSpace(Model.Email)
                    ? "Email not provided"
                    : Model.Email)

            </p>

        </div>


        <!-- =====================================
             PROFILE ACTIONS
             ===================================== -->

        <div class="sa-profile-hero-status">

            <!-- ACCOUNT STATUS -->

            <span class="sa-profile-status @(Model.IsActive ? "is-active" : "is-inactive")">

                <i class="bi bi-circle-fill"></i>

                @Model.AccountStatus

            </span>


            <!-- EDIT PROFILE -->

            <a asp-controller="Teacher"
               asp-action="EditProfile"
               class="sa-edit-profile-button">

                <i class="bi bi-pencil-square"></i>

                Edit Profile

            </a>


            <!-- =====================================
                 UPLOAD PROFILE PICTURE
                 ===================================== -->

            <form asp-controller="Teacher"
                  asp-action="UploadProfilePicture"
                  method="post"
                  asp-antiforgery="false"
                  enctype="multipart/form-data"
                  class="sa-profile-upload-form">

                @Html.AntiForgeryToken()


                <label for="teacherPictureInput"
                       class="sa-profile-upload-label">

                    <i class="bi bi-camera"></i>

                    Choose Profile Picture

                </label>


                <input type="file"
                       id="teacherPictureInput"
                       name="picture"
                       accept="image/jpeg,image/png,image/webp"
                       class="sa-profile-picture-input"
                       required />


                <small class="sa-profile-upload-hint">

                    JPG, PNG or WebP · Maximum 2 MB

                </small>


                <button type="submit"
                        class="sa-profile-upload-button">

                    <i class="bi bi-cloud-arrow-up"></i>

                    Upload Picture

                </button>

            </form>


            <!-- =====================================
                 REMOVE PROFILE PICTURE
                 ===================================== -->
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
            {
                <form asp-controller="Teacher"
                      asp-action="RemoveProfilePicture"
                      method="post"
                      asp-antiforgery="false"
                      class="sa-profile-remove-form"
                      onsubmit="return confirm('Are you sure you want to remove your profile picture?');">

                    @Html.AntiForgeryToken()


                    <button type="submit"
                            class="sa-profile-remove-button">

                        <i class="bi bi-trash3"></i>

                        Remove Picture

                    </button>

                </form>
            }

        </div>

    </div>


    <!-- ==========================================
         PROFILE CONTENT
         ========================================== -->

    <div class="sa-profile-grid">


        <!-- =====================================
             ACCOUNT INFORMATION
             ===================================== -->

        <section class="sa-profile-card">

            <div class="sa-profile-card-header">

                <div>

                    <h3>
                        <i class="bi bi-person-vcard"></i>
                        Account Information
                    </h3>

                    <p>
                        Your registered Teacher account details
                    </p>

                </div>

            </div>


            <div class="sa-profile-card-body">

                <!-- FULL NAME -->

                <div class="sa-profile-field">

                    <span>Full Name</span>

                    <strong>@Model.FullName</strong>

                </div>


                <!-- EMAIL -->

                <div class="sa-profile-field">

                    <span>Email Address</span>

                    <strong>

                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "Not provided"
                            : Model.Email)

                    </strong>

                </div>


                <!-- PHONE -->

                <div class="sa-profile-field">

                    <span>Phone Number</span>

                    <strong>

                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "Not provided"
                            : Model.Phone)

                    </strong>

                </div>


                <!-- ROLE -->

                <div class="sa-profile-field">

                    <span>Account Role</span>

                    <strong>@Model.Role</strong>

                </div>


                <!-- SCHOOL -->

                <div class="sa-profile-field">

                    <span>School</span>

                    <strong>@Model.SchoolName</strong>

                </div>


                <!-- SCHOOL ADDRESS -->
                @if (!string.IsNullOrWhiteSpace(Model.SchoolAddress))
                {
                    <div class="sa-profile-field">

                        <span>School Address</span>

                        <strong>
                            @Model.SchoolAddress
                        </strong>

                    </div>
                }



                <!-- =====================================
                     MEMBER SINCE
                     ===================================== -->
                @if (Model.MemberSince.HasValue)
                {
                    <div class="sa-profile-field">

                        <span>Member Since</span>

                        <strong>
                            @(Model.MemberSince.Value.ToLocalTime().ToString("dd MMM yyyy"))
                        </strong>

                    </div>
                }


            </div>

        </section>


        <!-- =====================================
             SIDE COLUMN
             ===================================== -->

        <div class="sa-profile-side-column">


            <!-- ACCOUNT SECURITY -->

            <section class="sa-profile-card">

                <div class="sa-profile-card-header">

                    <div>

                        <h3>

                            <i class="bi bi-shield-lock"></i>

                            Account &amp; Security

                        </h3>

                        <p>
                            Manage your account access
                        </p>

                    </div>

                </div>


                <div class="sa-profile-card-body">

                    <!-- RESET PASSWORD -->

                    <a asp-controller="Auth"
                       asp-action="ForgotPassword"
                       class="sa-profile-action">

                        <div class="sa-profile-action-icon">

                            <i class="bi bi-key"></i>

                        </div>


                        <div class="sa-profile-action-text">

                            <strong>
                                Reset Password
                            </strong>

                            <small>
                                Request a secure password reset link
                            </small>

                        </div>


                        <i class="bi bi-chevron-right sa-profile-arrow"></i>

                    </a>


                    <!-- SECURITY NOTE -->

                    <div class="sa-profile-security-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Your profile is linked to your
                            registered Teacher account.
                            School administrators manage
                            roles and school assignments.
                        </span>

                    </div>


                    <div class="teacher-profile-note">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Keep your account credentials
                            private and use a secure password.
                        </span>

                    </div>

                </div>

            </section>


            <!-- =====================================
                 SCHOOL INFORMATION
                 ===================================== -->

            <section class="sa-profile-card">

                <div class="sa-profile-card-header">

                    <div>

                        <h3>

                            <i class="bi bi-building"></i>

                            School Information

                        </h3>

                        <p>
                            Your assigned school
                        </p>

                    </div>

                </div>


                <div class="sa-profile-card-body">

                    <div class="sa-profile-school">

                        <div class="sa-profile-school-icon">

                            <i class="bi bi-buildings"></i>

                        </div>

                        <div>

                            <strong>
                                @Model.SchoolName
                            </strong>

                            <span>
                                Assigned School
                            </span>

                        </div>

                    </div>


                    <!-- ACCOUNT STATUS -->

                    <div class="sa-profile-field">

                        <span>Account Status</span>

                        <strong class="@(Model.IsActive ? "sa-status-active" : "sa-status-inactive")">

                            @Model.AccountStatus

                        </strong>

                    </div>

                </div>

            </section>

        </div>

    </div>

</section>


@section Scripts
{
    <script>
        document.querySelector(
            '.sa-profile-upload-form'
        )?.addEventListener(
            'submit',
            function (event) {

                const file =
                    document.getElementById(
                        'teacherPictureInput'
                    )?.files?.[0];

                if (file &&
                    file.size > 2 * 1024 * 1024) {

                    event.preventDefault();

                    alert(
                        'Choose an image smaller than 2 MB.'
                    );
                }
            }
        );
    </script>
}
