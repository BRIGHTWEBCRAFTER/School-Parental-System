@model SchoolParentalSystem.Web.ViewModels.Teacher.TeacherGradesViewModel

@{
    ViewData["Title"] = "Grade Recording";
    Layout = "_TeacherLayout";

    var selectedClassName = Model.Classes
        .FirstOrDefault(c => c.Id == Model.SelectedClassId)
        ?.Name ?? "Selected Class";
}

<link rel="stylesheet"
      href="~/css/teacher/teacher-grade-recording.css"
      asp-append-version="true" />

<section class="dashboard-content teacher-grade-page">

    <!-- PAGE INTRODUCTION -->

    <div class="tg-intro">
        <div>
            <h2>Grade Recording</h2>
            <p>
                Review assessments and learner results
                for your assigned subjects.
            </p>
        </div>

        <span class="tg-page-badge">
            <i class="bi bi-journal-check"></i>
            Grade Management
        </span>
    </div>

    <!-- INFORMATION BANNER -->

    <div class="tg-notice">
        <i class="bi bi-info-circle"></i>

        <p>
            <strong>Teacher Grade Management:</strong>
            Record results for your assigned classes and subjects,
            save assessments as drafts, and edit them before publishing.
            Published grades are read-only in Teacher Grade Recording.
        </p>
    </div>


    <!-- GRADE RECORDING FEEDBACK -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="tg-feedback tg-feedback-success"
             role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="tg-feedback tg-feedback-error"
             role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }


    @if (Model.DataLoadFailed)
    {
        <div class="tg-empty">
            <i class="bi bi-exclamation-triangle"></i>
            <h3>Unable to load grades</h3>
            <p>Please reload the page and try again.</p>
        </div>
    }
    else if (!Model.HasTeacherProfile)
    {
        <div class="tg-empty">
            <i class="bi bi-person-exclamation"></i>
            <h3>Teacher profile unavailable</h3>
            <p>Please contact your School Administrator.</p>
        </div>
    }
    else
    {
        <!-- STATISTICS -->

        <div class="tg-stat-grid">

            <div class="tg-stat-card">
                <div class="tg-stat-icon">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                </div>
                <div>
                    <span>Grade Entries</span>
                    <strong>@Model.TotalGradeRecords</strong>
                </div>
            </div>

            <div class="tg-stat-card">
                <div class="tg-stat-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>
                <div>
                    <span>Assessments</span>
                    <strong>@Model.AssessmentCount</strong>
                </div>
            </div>

            <div class="tg-stat-card">
                <div class="tg-stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <span>Learners Graded</span>
                    <strong>@Model.LearnersGraded</strong>
                </div>
            </div>

            <div class="tg-stat-card">
                <div class="tg-stat-icon">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <span>Assigned Subjects</span>
                    <strong>@Model.AssignedSubjectCount</strong>
                </div>
            </div>

        </div>

        <!-- GRADE FILTERS -->

        <section class="tg-card">

            <div class="tg-card-heading">
                <h3>
                    <i class="bi bi-funnel"></i>
                    Grade Records
                </h3>

                <p>
                    Filter by class, subject, term or learner.
                </p>
            </div>

            <form asp-controller="Teacher"
                  asp-action="GradeRecording"
                  method="get"
                  class="tg-filter-form">

                <div class="tg-field">
                    <label for="classId">Class</label>

                    <select id="classId"
                            name="classId"
                            required>

                        <option value="">Select Class</option>

                        @foreach (var schoolClass in Model.Classes)
                        {
                            <option value="@schoolClass.Id"
                                    selected="@(Model.SelectedClassId == schoolClass.Id ? "selected" : null)">
                                @schoolClass.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="tg-field">
                    <label for="subjectId">Subject</label>

                    <select id="subjectId" name="subjectId">

                        <option value="">All Assigned Subjects</option>

                        @foreach (var subject in Model.Subjects)
                        {
                            <option value="@subject.Id"
                                    selected="@(Model.SelectedSubjectId == subject.Id ? "selected" : null)">
                                @subject.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="tg-field">
                    <label for="term">Term</label>

                    <select id="term" name="term">
                        <option value="">All Terms</option>

                        @foreach (var term in Model.Terms)
                        {
                            <option value="@term"
                                    selected="@(Model.SelectedTerm == term ? "selected" : null)">
                                @term
                            </option>
                        }
                    </select>
                </div>

                <div class="tg-field">
                    <label for="search">Search Learner</label>

                    <input type="search"
                           id="search"
                           name="search"
                           value="@Model.SearchTerm"
                           maxlength="100"
                           placeholder="Name or admission no." />
                </div>

                <button type="submit"
                        class="tg-primary-button">
                    <i class="bi bi-search"></i>
                    Load Grades
                </button>

            </form>
        </section>


        <!-- ==========================================
             RECORD GRADES / SAVE DRAFT
             ========================================== -->
        @if (Model.CanRecordGrades)
        {
            <section class="tg-card tg-entry-card">

                <div class="tg-card-header">

                    <div>
                        <h3>
                            <i class="bi bi-pencil-square"></i>
                            @(Model.IsEditingDraft
                                ? "Edit Saved Draft"
                                : "Record Learner Grades")
                        </h3>

                        <p>
                            Enter assessment information and
                            marks for enrolled learners.
                        </p>
                    </div>

                    <span class="tg-draft-badge">
                        <i class="bi bi-file-earmark"></i>
                        @(Model.IsEditingDraft ? "Editing Draft" : "Save as Draft")
                    </span>

                </div>

                @if (Model.EntryLearners.Count == 0)
                {
                    <div class="tg-empty">

                        <i class="bi bi-people"></i>

                        <h3>No enrolled learners</h3>

                        <p>
                            No active learners were found
                            for this class and academic year.
                        </p>

                    </div>
                }
                else
                {
                    <form asp-controller="Teacher"
                          asp-action="SaveGradeDraft"
                          asp-antiforgery="true"
                          method="post">

                        <!-- SELECTED CLASS AND SUBJECT -->

                        <input type="hidden"
                               name="ClassId"
                               value="@Model.SelectedClassId" />

                        <input type="hidden"
                               name="SubjectId"
                               value="@Model.SelectedSubjectId" />

                        <input type="hidden"
                               name="AcademicYear"
                               value="@Model.AcademicYear" />

                        @* Disabled selects are not posted; hidden inputs preserve
            the original type and term during draft edits. *@
                        @if (Model.IsEditingDraft)
                        {
                            <input type="hidden"
                                   name="AssessmentType"
                                   value="@Model.EditingAssessmentType" />

                            <input type="hidden"
                                   name="AcademicTerm"
                                   value="@Model.EditingTerm" />
                        }

                        <!-- ASSESSMENT DETAILS -->

                        <div class="tg-assessment-fields">

                            <div class="tg-field">
                                <label for="AssessmentName">
                                    Assessment Name
                                </label>

                                <input type="text"
                                       id="AssessmentName"
                                       name="AssessmentName"
                                       maxlength="100"
                                       placeholder="e.g. Mathematics Test 1"
                                       value="@Model.EditingAssessmentName"
                                       readonly="@(Model.IsEditingDraft ? "readonly" : null)"
                                       required />
                            </div>

                            <div class="tg-field">
                                <label for="AssessmentType">
                                    Assessment Type
                                </label>

                                <select id="AssessmentType"
                                        name="AssessmentType"
                                        disabled="@(Model.IsEditingDraft ? "disabled" : null)"
                                        required>

                                    <option value="">
                                        Select Type
                                    </option>

                                    <option value="Test"
                                            selected="@(Model.EditingAssessmentType == "Test" ? "selected" : null)">
                                        Test
                                    </option>

                                    <option value="Assignment"
                                            selected="@(Model.EditingAssessmentType == "Assignment" ? "selected" : null)">
                                        Assignment
                                    </option>

                                    <option value="Exam"
                                            selected="@(Model.EditingAssessmentType == "Exam" ? "selected" : null)">
                                        Exam
                                    </option>

                                </select>
                            </div>

                            <div class="tg-field">
                                <label for="AcademicTerm">
                                    Academic Term
                                </label>

                                <select id="AcademicTerm"
                                        name="AcademicTerm"
                                        disabled="@(Model.IsEditingDraft ? "disabled" : null)"
                                        required>

                                    <option value="">
                                        Select Term
                                    </option>

                                    @foreach (var term in Model.Terms)
                                    {
                                        <option value="@term"
                                                selected="@((Model.IsEditingDraft
                                                    ? Model.EditingTerm == term
                                                    : Model.SelectedTerm == term)
                                                    ? "selected" : null)">
                                            @term
                                        </option>
                                    }

                                </select>
                            </div>

                            <div class="tg-field">
                                <label for="MaximumMarks">
                                    Maximum Marks
                                </label>

                                <input type="number"
                                       id="MaximumMarks"
                                       name="MaximumMarks"
                                       min="0.01"
                                       max="10000"
                                       step="0.01"
                                       placeholder="e.g. 50"
                                       value="@(Model.EditingMaximumMarks?.ToString(
                                           "0.##",
                                           System.Globalization.CultureInfo.InvariantCulture))"
                                       readonly="@(Model.IsEditingDraft ? "readonly" : null)"
                                       required />
                            </div>

                        </div>

                        <!-- LEARNER MARKS REGISTER -->

                        <div class="tg-entry-heading">

                            <div>
                                <h3>
                                    <i class="bi bi-people"></i>
                                    Learner Marks Register
                                </h3>

                                <p>
                                    Leave marks blank for learners
                                    whose results are not yet available.
                                </p>
                            </div>

                            <span class="tg-count">
                                @Model.EntryLearners.Count learners
                            </span>

                        </div>

                        <div class="tg-table-wrapper">

                            <table class="tg-table tg-entry-table">

                                <thead>
                                    <tr>
                                        <th>No.</th>
                                        <th>Admission Number</th>
                                        <th>Learner Name</th>
                                        <th>Marks Obtained</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @for (var i = 0;
                                   i < Model.EntryLearners.Count;
                                   i++)
                                    {
                                        var learner =
                                        Model.EntryLearners[i];

                                        <tr>
                                            <td>@(i + 1)</td>

                                            <td class="tg-strong">
                                                @learner.AdmissionNumber
                                            </td>

                                            <td class="tg-strong">
                                                <i class="bi bi-person-circle"></i>
                                                @learner.FullName

                                                <input type="hidden"
                                                       name="Learners[@i].LearnerId"
                                                       value="@learner.LearnerId" />
                                            </td>

                                            <td>
                                                <input type="number"
                                                       name="Learners[@i].MarksObtained"
                                                       class="tg-marks-input"
                                                       min="0"
                                                       max="10000"
                                                       step="0.01"
                                                       placeholder="Marks"
                                                       value="@(learner.MarksObtained?.ToString(
                                                           "0.##",
                                                           System.Globalization.CultureInfo.InvariantCulture))"
                                                       aria-label="Marks for @learner.FullName" />
                                            </td>

                                            <td>
                                                <input type="text"
                                                       name="Learners[@i].Remarks"
                                                       class="tg-remarks-input"
                                                       maxlength="255"
                                                       placeholder="Optional remarks"
                                                       value="@learner.Remarks"
                                                       aria-label="Remarks for @learner.FullName" />
                                            </td>


                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <!-- SAVE DRAFT FOOTER -->

                        <div class="tg-entry-footer">

                            <div class="tg-draft-info">
                                <i class="bi bi-shield-check"></i>

                                <span>
                                    Saving a draft does not
                                    publish the grades to
                                    parents or School Admin.
                                    Existing published results
                                    cannot be overwritten
                                    through Save Draft.
                                </span>
                            </div>

                            <button type="submit"
                                    class="tg-primary-button tg-save-button">

                                <i class="bi bi-floppy"></i>
                                @(Model.IsEditingDraft
                                    ? "Update Draft"
                                    : "Save Draft")

                            </button>

                        </div>

                    </form>
                }

            </section>
        }


        <!-- RESULTS -->
        @if (Model.InvalidSelection)
        {
            <div class="tg-empty">
                <i class="bi bi-shield-lock"></i>

                <h3>Invalid selection</h3>

                <p>
                    The selected class, subject or term
                    is not available to your Teacher account.
                </p>
            </div>
        }
        else if (Model.Classes.Count == 0)
        {
            <div class="tg-empty">
                <i class="bi bi-book"></i>

                <h3>No assigned subjects</h3>

                <p>
                    Your School Administrator has not
                    assigned an active subject to you.
                </p>
            </div>
        }
        else if (!Model.SelectedClassId.HasValue)
        {
            <div class="tg-empty">
                <i class="bi bi-easel"></i>

                <h3>Select a class</h3>

                <p>
                    Choose one of your assigned classes
                    and click Load Grades.
                </p>
            </div>
        }
        else
        {
            <section class="tg-card tg-record-card">

                <div class="tg-card-header">
                    <div>
                        <h3>
                            <i class="bi bi-journal-text"></i>
                            @selectedClassName — Grade Records
                        </h3>

                        <p>
                            Academic Year @Model.AcademicYear
                        </p>
                    </div>

                    <span class="tg-count">
                        @Model.TotalGradeRecords records
                    </span>
                </div>

                @if (Model.Records.Count == 0)
                {
                    <div class="tg-empty">
                        <i class="bi bi-inbox"></i>

                        <h3>No grades found</h3>

                        <p>
                            No grade records match the
                            selected class and filters.
                        </p>
                    </div>
                }
                else
                {
                    <div class="tg-table-wrapper">
                        <table class="tg-table">

                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Admission Number</th>
                                    <th>Learner Name</th>
                                    <th>Subject</th>
                                    <th>Assessment</th>
                                    <th>Type</th>
                                    <th>Term</th>
                                    <th>Score</th>
                                    <th>Grade</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (int i = 0; i < Model.Records.Count; i++)
                                {
                                    var record = Model.Records[i];

                                    <tr>
                                        <td>@(i + 1)</td>

                                        <td class="tg-strong">
                                            @record.AdmissionNumber
                                        </td>

                                        <td class="tg-strong">
                                            @record.LearnerName
                                        </td>

                                        <td>@record.SubjectName</td>

                                        <td>@record.AssessmentName</td>

                                        <td>@record.AssessmentType</td>

                                        <td>@record.AcademicTerm</td>

                                        <td class="tg-score">
                                            @record.Score.ToString("0.##")
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                record.GradeLetter)
                                                ? "—"
                                                : record.GradeLetter)
                                        </td>

                                        <td class="tg-remarks">
                                            @(string.IsNullOrWhiteSpace(
                                                record.Remarks)
                                                ? "—"
                                                : record.Remarks)
                                        </td>

                                        <!-- PUBLICATION STATUS -->
                                        <td>
                                            @if (record.PublicationStatus == "Published")
                                            {
                                                <span class="tg-status tg-status-published">
                                                    <i class="bi bi-check-circle"></i>
                                                    Published
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tg-status tg-status-draft">
                                                    <i class="bi bi-pencil-square"></i>
                                                    Draft
                                                </span>
                                            }
                                        </td>

                                        <!-- EDIT DRAFT -->
                                        <td>
                                            @if (record.CanEditDraft)
                                            {
                                                <a asp-controller="Teacher"
                                                   asp-action="GradeRecording"
                                                   asp-route-classId="@Model.SelectedClassId"
                                                   asp-route-subjectId="@record.SubjectId"
                                                   asp-route-term="@record.AcademicTerm"
                                                   asp-route-editAssessment="@record.AssessmentName"
                                                   class="tg-edit-link">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit Draft
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="tg-no-action">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                    <!-- ==========================================
                         PUBLISH DRAFT ASSESSMENTS
                         ========================================== -->
                    @if (Model.SelectedSubjectId.HasValue)
                    {
                        var draftAssessments = Model.Records
                        .Where(r =>
                        r.CanEditDraft &&
                        r.PublicationStatus == "Draft")
                        .GroupBy(r => new
                        {
                            r.SubjectId,
                            r.AssessmentName,
                            r.AcademicTerm,
                            r.AcademicYear
                        })
                        .Select(g => new
                        {
                            Assessment = g.First(),
                            SavedLearners = g.Select(r => r.LearnerId)
                        .Distinct()
                        .Count()
                        })
                        .ToList();

                        if (draftAssessments.Count > 0)
                        {
                            <div class="tg-publish-section">

                                <div class="tg-publish-heading">
                                    <h3>
                                        <i class="bi bi-send-check"></i>
                                        Publish Assessments
                                    </h3>

                                    <p>
                                        Review your saved drafts before
                                        making results visible.
                                    </p>
                                </div>

                                @foreach (var draft in draftAssessments)
                                {
                                    var isComplete =
                                    Model.EntryLearners.Count > 0 &&
                                    draft.SavedLearners ==
                                    Model.EntryLearners.Count;

                                    <div class="tg-publish-item">

                                        <div class="tg-publish-details">
                                            <strong>
                                                @draft.Assessment.AssessmentName
                                            </strong>

                                            <span>
                                                @draft.Assessment.SubjectName
                                                —
                                                @draft.Assessment.AcademicTerm
                                            </span>

                                            <small>
                                                @draft.SavedLearners of
                                                @Model.EntryLearners.Count
                                                learner results saved
                                            </small>
                                        </div>

                                        <form asp-controller="Teacher"
                                              asp-action="PublishGradeAssessment"
                                              asp-antiforgery="true"
                                              method="post"
                                              onsubmit="return confirm('Publish this assessment? All saved results will become visible to authorized School Admin and Parent accounts. Published grades cannot be edited through Teacher Grade Recording.');">

                                            <input type="hidden"
                                                   name="classId"
                                                   value="@Model.SelectedClassId" />

                                            <input type="hidden"
                                                   name="subjectId"
                                                   value="@draft.Assessment.SubjectId" />

                                            <input type="hidden"
                                                   name="assessmentName"
                                                   value="@draft.Assessment.AssessmentName" />

                                            <input type="hidden"
                                                   name="academicTerm"
                                                   value="@draft.Assessment.AcademicTerm" />

                                            <input type="hidden"
                                                   name="academicYear"
                                                   value="@draft.Assessment.AcademicYear" />

                                            <button type="submit"
                                                    class="tg-publish-button"
                                                    disabled="@(!isComplete)">

                                                <i class="bi bi-send-check"></i>

                                                Publish Grades

                                            </button>

                                        </form>

                                    </div>

                                    @if (!isComplete)
                                    {
                                        <p class="tg-publish-warning">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Save marks for all enrolled learners
                                            before publishing this assessment.
                                        </p>
                                    }
                                }

                            </div>
                        }
                    }

                }

                <div class="tg-footer">
                    <i class="bi bi-info-circle"></i>

                    <span>
                        Draft grades can be updated before publishing.
                        Published grades are read-only here.
                        Publication must be confirmed separately.
                    </span>
                </div>

            </section>
        }
    }

</section>
