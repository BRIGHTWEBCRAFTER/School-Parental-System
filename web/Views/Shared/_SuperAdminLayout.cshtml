@using System.Security.Claims
@using System.Linq
@inject SchoolParentalSystem.Web.Services.SuperAdmin.SuperAdminProfileService SuperAdminProfileService
@{
    var pageTitle =
        ViewData["Title"]?.ToString()
        ?? "Super Admin";

    var currentAction =
        ViewContext.RouteData.Values["action"]
            ?.ToString();

    var currentController =
        ViewContext.RouteData.Values["controller"]
            ?.ToString();

    var adminName =
        User.Identity?.Name
        ?? "Super Admin";

    var systemScope =
        ViewData["SystemScope"]?.ToString()
        ?? "All Schools";

    // Load a saved avatar for the logged-in Super Admin, as in the Teacher top bar.
    string? superAdminAvatarUrl = null;
    var avatarInitials = "SA";
    var superAdminIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    if (Guid.TryParse(superAdminIdClaim, out var superAdminId))
    {
        try
        {
            var profile = await SuperAdminProfileService.GetProfileAsync(superAdminId);
            superAdminAvatarUrl = profile.ProfilePicture;
            avatarInitials = string.Join("", (profile.FullName ?? "")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2).Select(part => part.Substring(0, 1).ToUpperInvariant()));
            if (string.IsNullOrEmpty(avatarInitials)) avatarInitials = "SA";
        }
        catch
        {
            // Top bar remains available if the photo cannot be loaded.
        }
    }

}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @pageTitle - School-Parental System
    </title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <link rel="stylesheet"
          href="~/css/super-admin/super-admin-dashboard.css"
          asp-append-version="true" />


    <!-- TOPBAR INTERACTIVE CONTROLS -->
    <style>
        .super-system-scope {
            text-decoration: none;
        }

        .super-search-box {
            margin: 0;
        }

        .super-search-submit {
            border: 0;
            background: transparent;
            padding: 0;
            cursor: pointer;
            color: #073f32;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .super-topbar .topbar-notification-menu {
            position: relative;
            z-index: 300;
        }

            .super-topbar .topbar-notification-menu > summary {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 9px;
                font-size: 19px;
                color: #073f32;
            }

                .super-topbar .topbar-notification-menu > summary:hover {
                    background: #fff3d9;
                }

        .super-topbar .notification-badge {
            position: absolute;
            top: -3px;
            right: -4px;
            min-width: 19px;
            height: 19px;
            border-radius: 20px;
            background: #eea400;
            color: #fff;
            font-weight: bold;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
        }

        .super-topbar .topbar-notification-panel {
            z-index: 600;
        }

        .super-profile-menu {
            position: relative;
            z-index: 200;
        }

            .super-profile-menu > summary {
                list-style: none;
            }

                .super-profile-menu > summary::-webkit-details-marker {
                    display: none;
                }

            .super-profile-menu[open] .super-profile-chevron {
                transform: rotate(180deg);
            }

        .super-profile-dropdown {
            position: absolute;
            right: 0;
            top: calc(100% + 12px);
            width: 265px;
            background: #fff;
            box-shadow: 0 15px 42px rgba(0,0,0,.16);
            border: 1px solid #e6dfd1;
            border-radius: 13px;
            padding: 10px;
            z-index: 600;
        }

        .super-profile-dropdown-header {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 12px 10px;
            border-bottom: 1px solid #e6dfd1;
            margin-bottom: 7px;
            font-size: 13px;
            color: #073f32;
        }

            .super-profile-dropdown-header span {
                font-size: 12px;
                color: #687b71;
            }

        .super-profile-menu-link {
            display: flex;
            width: 100%;
            align-items: center;
            gap: 11px;
            padding: 12px 10px;
            font: inherit;
            font-size: 13px;
            color: #073f32;
            text-decoration: none;
            background: transparent;
            border: 0;
            cursor: pointer;
            text-align: left;
            border-radius: 8px;
            box-sizing: border-box;
        }

            .super-profile-menu-link:hover {
                background: #f2f7f0;
            }

        .super-profile-logout {
            color: #b42318;
        }

        .super-profile-avatar {
            overflow: hidden;
            border-radius: 50%;
        }

        .super-admin-topbar-photo {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            border-radius: 50%;
        }

        .super-profile-dropdown form {
            margin: 0;
        }

        @@media (max-width:700px) {
            .super-profile-dropdown {
                right: -5px;
            }

            .super-topbar .topbar-notification-panel {
                right: -110px;
            }
        }
    </style>

</head>


<body>

    <div class="super-admin-shell">

        <!-- =========================================
             SIDEBAR
             ========================================= -->

        <aside class="super-sidebar">

            <div class="super-brand">

                <div class="super-brand-logo">

                    <img src="~/images/dbe-logo.webp"
                         alt="Department of Basic Education"
                         class="super-dbe-logo" />

                </div>


                <div class="super-brand-text">

                    <strong>
                        School-Parental
                    </strong>

                    <span>
                        System
                    </span>

                    <small>
                        Super Administration
                    </small>

                </div>

            </div>


            <!-- =========================================
                 MAIN NAVIGATION
                 ========================================= -->

            <nav class="super-sidebar-nav">


                <!-- DASHBOARD -->

                <a class="super-nav-item @(
                   currentAction == "Dashboard"
                       ? "active"
                       : "")"
                   asp-controller="SuperAdmin"
                   asp-action="Dashboard">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- SCHOOLS -->

                <a class="super-nav-item @(
                                       currentAction == "Schools" ||
                                       currentAction == "AddSchool" ||
                                       currentAction == "SchoolDetails" ||
                                       currentAction == "EditSchool"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdmin"
                   asp-action="Schools">

                    <i class="bi bi-buildings-fill"></i>

                    <span>
                        Schools
                    </span>

                </a>


                <!-- USERS -->

                <a class="super-nav-item @(
                                       currentAction == "Users" ||
                                       currentAction == "UserDetails" ||
                                       currentAction == "EditUser" ||
                                       currentAction == "SchoolAdmins" ||
                                       currentAction == "AddSchoolAdmin"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdmin"
                   asp-action="Users">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- COMMUNICATION -->

                <a class="super-nav-item @(
                                       currentAction == "Communication" ||
                                       currentAction == "Announcements" ||
                                       currentAction == "CreateAnnouncement" ||
                                       currentAction == "Events" ||
                                       currentAction == "CreateEvent"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdmin"
                   asp-action="Announcements">

                    <i class="bi bi-chat-left-text-fill"></i>

                    <span>
                        Communication
                    </span>

                </a>


                <!-- =========================================
                     MONITORING
                     ========================================= -->

                <div class="super-nav-section-label">
                    Monitoring
                </div>


                <!-- REPORTS & ANALYTICS -->

                <a class="super-nav-item @(
                                       currentAction == "Reports"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdmin"
                   asp-action="Reports">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Reports & Analytics
                    </span>

                </a>


                <!-- SYSTEM ACTIVITY -->

                <a class="super-nav-item @(
                                       currentAction == "AuditLogs"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdmin"
                   asp-action="AuditLogs">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        System Activity
                    </span>

                </a>


                <!-- ACCESS CODES -->

                <a class="super-nav-item @(
                                       currentController == "SuperAdminAccessCode" &&
                                       currentAction == "AccessCodes"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdminAccessCode"
                   asp-action="AccessCodes">

                    <i class="bi bi-key-fill"></i>

                    <span>
                        Access Codes
                    </span>

                </a>

            </nav>


            <!-- =========================================
                 BOTTOM ACCOUNT NAVIGATION
                 ========================================= -->

            <div class="super-sidebar-bottom">


                <!-- PROFILE -->

                <a class="super-nav-item @(
                                       currentController == "SuperAdminProfile" &&
                                       currentAction == "Profile"
                                           ? "active"
                                           : "")"
                   asp-controller="SuperAdminProfile"
                   asp-action="Profile">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        Profile
                    </span>

                </a>


                <!-- LOGOUT -->

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post"
                      class="super-logout-form">

                    @Html.AntiForgeryToken()


                    <button type="submit"
                            class="super-nav-item super-logout-button">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>
                            Logout
                        </span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- =========================================
             MAIN AREA
             ========================================= -->

        <main class="super-main-area">


            <!-- =========================================
                 TOPBAR
                 ========================================= -->

            <header class="super-topbar">

                <div class="super-topbar-left">


                    <!-- SYSTEM SCOPE -->

                    <a class="super-system-scope" asp-controller="SuperAdmin" asp-action="Schools" title="View all schools">

                        <i class="bi bi-buildings-fill"></i>

                        <span>
                            @systemScope
                        </span>

                    </a>


                    <!-- PAGE HEADING -->

                    <div class="super-page-heading">

                        <h1>
                            @pageTitle
                        </h1>

                        <p>
                            Manage and monitor the entire
                            School-Parental System.
                        </p>

                    </div>

                </div>


                <div class="super-topbar-right">


                    <!-- SEARCH: searches schools and users -->
                    <form class="super-search-box"
                          asp-controller="SuperAdminTopbar"
                          asp-action="Search"
                          method="get"
                          role="search">
                        <button type="submit" aria-label="Search schools and users"
                                class="super-search-submit">
                            <i class="bi bi-search"></i>
                        </button>
                        <input type="search" name="query" maxlength="100"
                               value="@(Context.Request.Query["query"].ToString())"
                               placeholder="Search schools, users, administrators..."
                               aria-label="Search schools and users" required />
                    </form>
                    <!-- ACTUAL NOTIFICATIONS / MARK AS READ -->
                    @await Component.InvokeAsync("TopbarNotifications")

                    <!-- CURRENT SUPER ADMIN -->

                    <details class="super-profile-menu">
                        <summary class="super-profile-summary"
                                 aria-label="Open Super Admin account menu">
                            <div class="super-profile-avatar">
                                @if (!string.IsNullOrWhiteSpace(superAdminAvatarUrl))
                                {
                                    <img src="@superAdminAvatarUrl"
                                         class="super-admin-topbar-photo"
                                         alt="My profile picture" />
                                }
                                else
                                {
                                    @avatarInitials
                                }
                            </div>
                            <div class="super-profile-details">
                                <strong>@adminName</strong>
                                <span>Super Admin</span>
                            </div>
                            <i class="bi bi-chevron-down super-profile-chevron"></i>
                        </summary>
                        <div class="super-profile-dropdown">
                            <div class="super-profile-dropdown-header">
                                <strong>@adminName</strong>
                                <span>Super Admin</span>
                            </div>
                            <a asp-controller="SuperAdminProfile" asp-action="Profile"
                               class="super-profile-menu-link">
                                <i class="bi bi-person-circle"></i> My Profile
                            </a>
                            <a asp-controller="SuperAdmin" asp-action="Schools"
                               class="super-profile-menu-link">
                                <i class="bi bi-buildings"></i> Manage Schools
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="super-profile-menu-link super-profile-logout" type="submit">
                                    <i class="bi bi-box-arrow-right"></i> Log Out
                                </button>
                            </form>
                        </div>
                    </details>

                </div>

            </header>


            <!-- =========================================
                 PAGE CONTENT
                 ========================================= -->

            <div class="super-page-body">

                @RenderBody()

            </div>

        </main>

    </div>


    @await RenderSectionAsync(
            "Scripts",
            required: false)

</body>

</html>