```cshtml
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Forgot Password - School-Parental System
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login-animated.css"
          asp-append-version="true" />

</head>

<body class="auth-body">

    <main class="auth-container">

        <div class="curved-shape"></div>
        <div class="curved-shape2"></div>


        <!-- =========================================
             RESET PASSWORD FORM
             ========================================= -->

        <section class="form-box Login">

            <h2>
                Reset Password
            </h2>


            <form asp-controller="Auth"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="auth-message success">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            @TempData["SuccessMessage"]
                        </span>

                    </div>
                }


                @if (ViewData["Message"] != null)
                {
                    <div class="auth-message success">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            @ViewData["Message"]
                        </span>

                    </div>
                }


                <div asp-validation-summary="ModelOnly"
                     class="auth-message error">
                </div>


                <!-- EMAIL -->

                <div class="input-box">

                    <input type="email"
                           name="Email"
                           id="forgotEmail"
                           autocomplete="email"
                           required />

                    <label for="forgotEmail">
                        Email Address
                    </label>

                    <i class="bi bi-envelope-fill field-icon"></i>

                </div>


                <!-- SEND BUTTON -->

                <div class="input-box">

                    <button class="btn"
                            type="submit">

                        <span>
                            Send Reset Link
                        </span>

                    </button>

                </div>


                <!-- BACK TO LOGIN -->

                <div class="regi-link">

                    <p>

                        Remember your password?

                        <br />

                        <a asp-controller="Auth"
                           asp-action="Login">

                            Back to Log In

                        </a>

                    </p>

                </div>

            </form>

        </section>


        <!-- =========================================
             INFORMATION PANEL
             ========================================= -->

        <section class="info-content Login">

            <div class="info-logo">

                <img src="~/images/dbe-logo.webp"
                     alt="Department of Basic Education" />

            </div>


            <h2>
                Forgot Password?
            </h2>


            <p>

                Enter the email address linked to your
                school account. We will send you a secure
                password reset link.

            </p>

        </section>

    </main>

</body>

</html>
```
